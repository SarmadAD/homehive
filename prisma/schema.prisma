generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
  directUrl    = env("DIRECT_URL")
}

model RentalObject {
  id                     String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt              DateTime          @default(now())
  name                   String
  image                  String
  address                String
  houseNr                Int
  additionalHouseDetails String?           @default("")
  city                   String
  postalCode             Int
  areaSize               Int
  renter                 Renter[]
  repairRequests         RepairRequest[]
  rentalObjectInfo       RentalObjectInfo  @relation(fields: [rentalObjectInfoId], references: [id])
  rentalObjectInfoId     String            @unique @db.Uuid
  landlord               Landlord          @relation(fields: [landlordId], references: [id])
  landlordId             String            @db.Uuid
  rentPayment            RentPayment[]
  rentalAgreement        RentalAgreement[]
  state                  Int               @default(1)

  @@index([rentalObjectInfoId])
  @@index([landlordId])
}

model Renter {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authenticatedUserId String           @db.Uuid
  createdAt           DateTime         @default(now())
  surname             String
  firstname           String
  email               String
  image               String
  rentalObjectId      String?
  rentalObject        RentalObject?    @relation(fields: [rentalObjectId], references: [id])
  repairRequest       RepairRequest[]
  landlords           Landlord[]
  rentPayment         RentPayment[]
  rentalAgreement     RentalAgreement? @relation(fields: [rentalAgreementId], references: [id])
  rentalAgreementId   String?          @unique @db.Uuid
  state               Int              @default(1)

  @@index([rentalObjectId])
  @@index([rentalAgreementId])
}

model Landlord {
  id                  String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authenticatedUserId String         @unique @db.Uuid
  hasAccess           Boolean        @default(false)
  priceId             String?
  customerId          String?        @unique
  rentalObjects       RentalObject[]
  renters             Renter[]
  tokens              Token[]
  rentPayments        RentPayment[]
}

model Token {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  access_token String
  expires_in   Int
  id_hint      String?
  scope        String
  token_type   String
  landlord     Landlord @relation(fields: [landlordId], references: [id])
  landlordId   String   @db.Uuid
  createdAt    DateTime @default(now())
  state        Int      @default(1)

  @@index([landlordId])
}

model RentalObjectInfo {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  baseRent         Int?
  serviceCharges   Int?
  heatingCosts     Int?
  waterCosts       Int?
  electricityCosts Int?
  rentalObject     RentalObject?
}

model RepairRequest {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt      DateTime            @default(now())
  name           String
  status         RepairRequestStatus
  comment        String?             @default("")
  renterId       String
  rentalObjectId String              @db.Uuid
  renter         Renter              @relation(fields: [renterId], references: [id])
  RentalObject   RentalObject        @relation(fields: [rentalObjectId], references: [id])

  @@index([renterId])
  @@index([rentalObjectId])
}

model UserRole {
  id                  String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authenticatedUserId String @db.Uuid
  role                Role   @relation(fields: [roleId], references: [id])
  roleId              String @db.Uuid

  @@index([roleId])
}

model Role {
  id       String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  role     String     @unique
  UserRole UserRole[]
}

model RentPayment {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  renter         Renter            @relation(fields: [renterId], references: [id])
  rentalObject   RentalObject      @relation(fields: [rentalObjectId], references: [id])
  landlord       Landlord          @relation(fields: [landlordId], references: [id])
  status         RentPaymentStatus
  paymentAmount  Float
  paymentDate    DateTime?
  dueDate        DateTime
  transactionId  String?           @unique
  renterId       String            @db.Uuid
  rentalObjectId String            @db.Uuid
  landlordId     String            @db.Uuid

  @@unique([transactionId, renterId])
  @@index([renterId])
  @@index([rentalObjectId])
  @@index([landlordId])
}

model RentalAgreement {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dueDateState   DueDateOfRent
  renter         Renter?
  rentalObject   RentalObject  @relation(fields: [rentalObjectId], references: [id])
  rentalObjectId String        @db.Uuid

  @@index([rentalObjectId])
}

enum DueDateOfRent {
  FIRSTMONTH
  MIDDLEMONTH
  ENDMONTH
}

enum RentPaymentStatus {
  PAID
  NOTPAID
  INARREARS
}

enum RepairRequestStatus {
  REQUESTED
  REJECTED
  DONE
  CANCELED
  INPROGRESS
}
