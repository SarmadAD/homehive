generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model RentalObject {
  id                     String             @id @default(uuid())
  createdAt              DateTime           @default(now())
  name                   String
  image                  String
  status                 RentalObjectStatus
  address                String
  houseNr                Int
  additionalHouseDetails String?            @default("")
  city                   String
  postalCode             String
  areaSize               Int
  renter                 Renter[]
  repairRequests         RepairRequest[]
  rentalObjectInfo       RentalObjectInfo   @relation(fields: [rentalObjectInfoId], references: [id])
  rentalObjectInfoId     String             @unique
  landlord               Landlord           @relation(fields: [landlordId], references: [id])
  landlordId             String
  rentPayment            RentPayment[]
  rentalAgreement        RentalAgreement[]

  @@index([rentalObjectInfoId])
  @@index([landlordId])
}

model Renter {
  id                String           @id @default(uuid())
  firebaseUserId    String
  createdAt         DateTime         @default(now())
  surname           String
  firstname         String
  email             String           @unique
  image             String
  rentalObjectId    String?
  rentalObject      RentalObject?    @relation(fields: [rentalObjectId], references: [id])
  repairRequest     RepairRequest[]
  landlords         Landlord[]
  rentPayment       RentPayment[]
  rentalAgreement   RentalAgreement? @relation(fields: [rentalAgreementId], references: [id])
  rentalAgreementId String?          @unique

  @@index([rentalObjectId])
  @@index([rentalAgreementId])
}

model Landlord {
  id             String         @id @default(uuid())
  firebaseUserId String         @unique
  rentalObjects  RentalObject[]
  renters        Renter[]
}

model RentalObjectInfo {
  id               String        @id @default(uuid())
  baseRent         Int
  heatingCosts     Int
  waterCosts       Int
  electricityCosts Int
  rentalObject     RentalObject?
}

model RepairRequest {
  id             String              @id @default(uuid())
  createdAt      DateTime            @default(now())
  name           String
  status         RepairRequestStatus
  comment        String?             @default("")
  renterId       String
  rentalObjectId String
  renter         Renter              @relation(fields: [renterId], references: [id])
  RentalObject   RentalObject        @relation(fields: [rentalObjectId], references: [id])

  @@index([renterId])
  @@index([rentalObjectId])
}

model UserRole {
  id             String @id @default(uuid())
  firebaseUserId String
  role           Role   @relation(fields: [roleId], references: [id])
  roleId         String

  @@index([roleId])
}

model Role {
  id       String     @id @default(uuid())
  role     String
  UserRole UserRole[]
}

model RentPayment {
  id             String            @id @default(uuid())
  renter         Renter            @relation(fields: [renterId], references: [id])
  rentalObject   RentalObject      @relation(fields: [rentalObjectId], references: [id])
  status         RentPaymentStatus
  paymentAmount  Float
  paymentDate    DateTime?
  dueDate        DateTime
  renterId       String
  rentalObjectId String

  @@index([renterId])
  @@index([rentalObjectId])
}

model RentalAgreement {
  id             String        @id @default(uuid())
  dueDateState   DueDateOfRent
  renter         Renter?
  rentalObject   RentalObject  @relation(fields: [rentalObjectId], references: [id])
  rentalObjectId String

  @@index([rentalObjectId])
}

enum RentalObjectStatus {
  INHABITED
  UNINHABITED
}

enum DueDateOfRent {
  FIRSTMONTH
  MIDDLEMONTH
  ENDMONTH
}

enum RentPaymentStatus {
  PAID
  NOTPAID
  INARREARS
}

enum RepairRequestStatus {
  REQUESTED
  REJECTED
  DONE
  CANCELED
  INPROGRESS
}
